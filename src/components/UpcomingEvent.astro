---
import { ArrowRight, CalendarDays, Clock3, ExternalLink, MapPin, Pin } from '@lucide/astro';
import newEntries from '../data/new-entries.json';
import archiveEntries from '../data/archive.json';
import { getUpcomingEvents, rigaDate } from '../utils/upcoming-events.mjs';

interface Props { lang: 'lv' | 'en'; }
const { lang } = Astro.props;
const lv = lang === 'lv';
const events = getUpcomingEvents([...archiveEntries, ...newEntries], lang, rigaDate());
const dateFormatter = new Intl.DateTimeFormat(lv ? 'lv-LV' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const moreUrl = (slug: string) => `${lv ? '/lv/aktualitates/' : '/en/updates/'}#${encodeURIComponent(slug)}`;
---
{events.length > 0 && <section id="upcoming-event" class="upcoming-event shell" data-upcoming-events aria-label={lv ? 'Tuvākais pasākums' : 'Next event'}>
  {events.map((event, index) => {
    const eventTime = event.event_time || event.body_markdown?.match(/\b\d{1,2}[.:]\d{2}\s*[–-]\s*\d{1,2}[.:]\d{2}\b/)?.[0] || '';
    const location = event.location || event.body_markdown?.match(/📍\s*([^\n]+)/)?.[1]?.replaceAll('**', '').trim() || '';
    const registrationUrl = event.registration_url || event.body_markdown?.match(/\[(?:Reģistrācija|Reģistrēties|Registration|Register)\]\((https?:\/\/[^\s)]+)\)/i)?.[1] || '';
    return <article class:list={['upcoming-event-card', { 'without-poster': !event.image_url }]} data-upcoming-event data-event-date={event.event_date.slice(0, 10)} hidden={index !== 0}>
    <span class="upcoming-event-pin" role="img" aria-label={lv ? 'Izcelts pasākums' : 'Featured event'} title={lv ? 'Izcelts pasākums' : 'Featured event'}><Pin size={18} aria-hidden="true" /></span>
    <div class="upcoming-event-copy">
      <div class="upcoming-event-meta"><span><CalendarDays size={17} aria-hidden="true" /><time datetime={event.event_date}>{dateFormatter.format(new Date(event.event_date))}</time></span>{eventTime && <span><Clock3 size={17} aria-hidden="true" />{eventTime}</span>}</div>
      <h2>{event.title}</h2>
      <p class="upcoming-event-summary">{event.summary}</p>
      {location && <p class="upcoming-event-location"><MapPin size={17} aria-hidden="true" /><span>{location}</span></p>}
      <div class="button-row">
        <a class="button secondary" href={moreUrl(event.slug)}>{lv ? 'Plašāk' : 'More information'}<ArrowRight size={17} aria-hidden="true" /></a>
        {registrationUrl && <a class="button primary" href={registrationUrl} target="_blank" rel="noopener noreferrer">{lv ? 'Reģistrēties' : 'Register'}<ExternalLink size={17} aria-hidden="true" /></a>}
      </div>
    </div>
    {event.image_url && <a class="upcoming-event-poster" href={moreUrl(event.slug)} aria-label={event.title}><img src={event.image_url} alt={event.image_alt || event.title} loading="lazy" referrerpolicy="no-referrer" /></a>}
  </article>;
  })}
</section>}
<script>
  const updateUpcomingEvent = () => {
    const section = document.querySelector<HTMLElement>('[data-upcoming-events]');
    if (!section) return;
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Riga', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    const cards = [...section.querySelectorAll<HTMLElement>('[data-upcoming-event]')];
    const next = cards.find(card => (card.dataset.eventDate || '') >= today);
    cards.forEach(card => { card.hidden = card !== next; });
    section.hidden = !next;
  };
  updateUpcomingEvent();
  document.addEventListener('visibilitychange', updateUpcomingEvent);
  setInterval(updateUpcomingEvent, 60_000);
</script>
