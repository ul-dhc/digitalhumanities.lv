        const active = link.source === node || link.target === node;
        lines[index]?.classList.toggle('is-active', active);
        lines[index]?.classList.toggle('is-dimmed', !active);
      });
      if (!networkPreview || !networkPreviewTitle || !networkPreviewKind || !networkPreviewSummary || !networkPreviewExpand || !networkPreviewActionLabel) return;
      const nodeValue = node.id.slice(node.id.indexOf(':') + 1);
      const relatedResources = node.kind === 'resource' ? 1 : currentMatching.filter((card) => {
        if (node.kind === 'topic') return (card.dataset.topics || '').split(' ').includes(nodeValue);
        if (node.kind === 'type') return (card.dataset.types || '').split(' ').includes(nodeValue);
        if (node.kind === 'institution') {
          const filter = selectedInstitutionFilters().find((item) => item.value === nodeValue);
          return filter ? cardMatchesInstitution(card, filter) : (JSON.parse(card.dataset.creators || '[]') as string[]).includes(nodeValue);
        }
        return false;
      }).length;
      networkPreviewKind.textContent = node.kind === 'resource' ? (document.documentElement.lang === 'lv' ? 'Resurss' : 'Resource') : node.kind === 'topic' ? (document.documentElement.lang === 'lv' ? 'Temats' : 'Topic') : node.kind === 'type' ? (document.documentElement.lang === 'lv' ? 'Resursa tips' : 'Resource type') : (document.documentElement.lang === 'lv' ? 'Institūcija' : 'Institution');
      networkPreviewTitle.textContent = node.label;
      networkPreviewSummary.textContent = node.card?.querySelector('.resource-summary')?.textContent?.trim() || `${relatedResources} ${document.documentElement.lang === 'lv' ? 'saistīti resursi' : 'related resources'}`;
      networkPreviewExpand.hidden = false;
      selectedPreviewCard = node.card;
      updatePreviewPin();
      if (node.card) {
        networkPreviewActionLabel.textContent = document.documentElement.lang === 'lv' ? 'Izvērst' : 'Expand';
        networkPreviewExpand.onclick = () => openResourceDetail(node.card!);
      } else {
        networkPreviewActionLabel.textContent = document.documentElement.lang === 'lv' ? 'Aplūkot visus jaunā cilnē' : 'View all in a new tab';
        networkPreviewExpand.onclick = () => {
          const url = new URL(window.location.href);
          url.hash = '';
          url.searchParams.set('view', 'cards');
          url.searchParams.set('pageSize', 'all');
          ['topic', 'type', 'institution'].forEach((key) => url.searchParams.delete(key));
          const value = node.id.slice(node.id.indexOf(':') + 1);
          if (node.kind === 'topic') url.searchParams.set('topic', value);
          if (node.kind === 'type') url.searchParams.set('type', value);
          if (node.kind === 'institution') url.searchParams.set('institution', value);
          window.open(url.toString(), '_blank', 'noopener,noreferrer');
        };
      }
      networkPreview.hidden = false;
      requestAnimationFrame(restorePreviewPosition);
    }

    const restorePreviewPosition = () => {
      if (!networkPreview || !networkStage) return;
      try {
        const saved = JSON.parse(localStorage.getItem(previewStorageKey) || 'null');
        if (!saved || typeof saved.x !== 'number' || typeof saved.y !== 'number') return;
        const stage = networkStage.getBoundingClientRect();
        const preview = networkPreview.getBoundingClientRect();
        const maxX = Math.max(8, stage.width - preview.width - 8);
        const maxY = Math.max(8, stage.height - preview.height - 8);
        networkPreview.style.left = `${Math.max(8, Math.min(maxX, saved.x * maxX))}px`;
        networkPreview.style.top = `${Math.max(8, Math.min(maxY, saved.y * maxY))}px`;
        networkPreview.style.right = 'auto'; networkPreview.style.bottom = 'auto';
      } catch { /* Ignore invalid locally stored coordinates. */ }
    };

    function zoomNetwork(factor: number, clientX?: number, clientY?: number) {
      if (!networkSvg) return;
      const bounds = networkSvg.getBoundingClientRect();
      const screenX = clientX === undefined ? bounds.width / 2 : clientX - bounds.left;
      const screenY = clientY === undefined ? bounds.height / 2 : clientY - bounds.top;
      const previousScale = graphTransform.scale;
      const nextScale = Math.max(.45, Math.min(3.2, previousScale * factor));
      graphTransform.x = screenX - ((screenX - graphTransform.x) / previousScale) * nextScale;
      graphTransform.y = screenY - ((screenY - graphTransform.y) / previousScale) * nextScale;
      graphTransform.scale = nextScale;
      updateGraphTransform();
    }

    function attachGraphInteractions() {
      if (!networkSvg || !networkStage) return;
      let panStart: { x: number; y: number; tx: number; ty: number } | undefined;
      let moved = false;
      const positionTooltip = (event: PointerEvent) => {
        if (!networkTooltip || !networkStage) return;
        const bounds = networkStage.getBoundingClientRect();
        const gap = 14;
        const edge = 10;
        const pointerX = event.clientX - bounds.left;
        const pointerY = event.clientY - bounds.top;
        const tooltipWidth = networkTooltip.offsetWidth;
        const tooltipHeight = networkTooltip.offsetHeight;
        let left = pointerX + gap;
        let top = pointerY - tooltipHeight - gap;
        if (left + tooltipWidth > bounds.width - edge) left = pointerX - tooltipWidth - gap;
        if (left < edge) left = edge;
        if (top < edge) top = pointerY + gap;
        if (top + tooltipHeight > bounds.height - edge) top = bounds.height - tooltipHeight - edge;
        networkTooltip.style.left = `${left}px`;
        networkTooltip.style.top = `${top}px`;
      };
      const updateNode = (node: GraphNode) => {
        networkSvg?.querySelector<SVGGElement>(`[data-node-id="${CSS.escape(node.id)}"]`)?.setAttribute('transform', `translate(${node.x} ${node.y})`);
        graphLinks.forEach((link, index) => {
          if (link.source !== node && link.target !== node) return;
          const line = networkSvg?.querySelectorAll<SVGLineElement>('.resource-network-links line')[index];
          if (!line) return;
          line.setAttribute('x1', String(link.source.x)); line.setAttribute('y1', String(link.source.y)); line.setAttribute('x2', String(link.target.x)); line.setAttribute('y2', String(link.target.y));
        });
      };
      networkSvg.querySelectorAll<SVGGElement>('.resource-network-node').forEach((element) => {
        const node = graphNodes.find((item) => item.id === element.dataset.nodeId);
        if (!node) return;
        element.addEventListener('pointerenter', (event) => {
          if (!networkTooltip) return;
          networkTooltip.textContent = node.label;
          networkTooltip.hidden = false;
          positionTooltip(event as PointerEvent);
        });
        element.addEventListener('pointermove', (event) => {
          if (networkTooltip && !networkTooltip.hidden) {
            positionTooltip(event);
          }
          if (graphDraggedNode !== node) return;
          moved = true;
          const point = graphPoint(event);
          const centreX = graphWidth * .52;
          const centreY = Math.min(132, graphHeight * .18) + (graphHeight - Math.min(132, graphHeight * .18)) * .5;
          const normalizedX = (point.x - centreX) / Math.max(1, graphWidth * .42);
          const normalizedY = (point.y - centreY) / Math.max(1, graphHeight * .43);
          const nextAngle = Math.atan2(normalizedY, normalizedX);
          let angleDelta = nextAngle - graphPreviousDragAngle;
          if (angleDelta > Math.PI) angleDelta -= Math.PI * 2;
          if (angleDelta < -Math.PI) angleDelta += Math.PI * 2;
          if (Math.abs(angleDelta) > .0015) graphTargetRotation = Math.max(-3, Math.min(3, angleDelta * 72));
          const verticalDelta = point.y - graphPreviousDragY;
          if (Math.abs(verticalDelta) > .12) graphTargetVerticalDrift = Math.max(-2.1, Math.min(2.1, verticalDelta * .075));
          graphPreviousDragAngle = nextAngle;
          graphPreviousDragY = point.y;
          node.x = point.x; node.y = Math.max(Math.min(132, graphHeight * .18) + 18, point.y); node.vx = 0; node.vy = 0; updateNode(node);
        });
        element.addEventListener('pointerleave', () => { if (networkTooltip) networkTooltip.hidden = true; });
        element.addEventListener('pointerdown', (event) => {
          event.stopPropagation(); moved = false; graphDraggedNode = node;
          const point = graphPoint(event);
          const safeTop = Math.min(132, graphHeight * .18);
          const centreY = safeTop + (graphHeight - safeTop) * .5;
          graphPreviousDragAngle = Math.atan2((point.y - centreY) / Math.max(1, (graphHeight - safeTop) * .48), (point.x - graphWidth * .54) / Math.max(1, graphWidth * .35));
          graphPreviousDragY = point.y;
          element.setPointerCapture(event.pointerId);
        });
        element.addEventListener('pointerup', () => { if (!moved) selectGraphNode(node); else storeGraphAnchor(node); graphDraggedNode = undefined; });
        element.addEventListener('pointercancel', () => { if (graphDraggedNode === node) storeGraphAnchor(node); graphDraggedNode = undefined; });
        element.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectGraphNode(node); } });
      });
      networkSvg.onpointerdown = (event) => { if ((event.target as Element).closest('.resource-network-node')) return; clearGraphSelection(); moved = false; panStart = { x: event.clientX, y: event.clientY, tx: graphTransform.x, ty: graphTransform.y }; networkSvg.setPointerCapture(event.pointerId); };
      networkSvg.onpointermove = (event) => { if (!panStart) return; moved = true; graphTransform.x = panStart.tx + event.clientX - panStart.x; graphTransform.y = panStart.ty + event.clientY - panStart.y; updateGraphTransform(); };
      networkSvg.onpointerup = () => { panStart = undefined; };
      networkSvg.onwheel = (event) => { event.preventDefault(); zoomNetwork(event.deltaY < 0 ? 1.12 : .89, event.clientX, event.clientY); };
    }

    root.querySelector('[data-network-zoom-in]')?.addEventListener('click', () => zoomNetwork(1.2));
    root.querySelector('[data-network-zoom-out]')?.addEventListener('click', () => zoomNetwork(.82));
    root.querySelector('[data-network-reset]')?.addEventListener('click', () => { graphTransform = { x: 0, y: 0, scale: 1 }; updateGraphTransform(); });
    const networkMotion = root.querySelector<HTMLButtonElement>('[data-network-motion]');
    const updateNetworkMotionControl = () => {
      if (!networkMotion) return;
      const label = graphMotionPaused ? networkMotion.dataset.resumeLabel : networkMotion.dataset.pauseLabel;
      networkMotion.setAttribute('aria-pressed', String(graphMotionPaused));
      if (label) { networkMotion.setAttribute('aria-label', label); networkMotion.title = label; }
      networkMotion.querySelector<HTMLElement>('[data-motion-pause]')?.toggleAttribute('hidden', graphMotionPaused);
      networkMotion.querySelector<HTMLElement>('[data-motion-play]')?.toggleAttribute('hidden', !graphMotionPaused);
    };
    networkMotion?.addEventListener('click', () => {
      graphMotionPaused = !graphMotionPaused;
      if (graphMotionPaused) window.cancelAnimationFrame(graphAnimationFrame);
      else if (root.dataset.view === 'explore' && explorerMode === 'network') startGraphDrift(graphWidth, graphHeight);
      updateNetworkMotionControl();
    });
    updateNetworkMotionControl();
    root.querySelector('[data-network-preview-close]')?.addEventListener('click', clearGraphSelection);
    networkPreviewPin?.addEventListener('click', () => { if (selectedPreviewCard) togglePinnedResource(selectedPreviewCard); });
    networkPinsClear?.addEventListener('click', () => { pinnedSlugs.clear(); persistPins(); renderPinnedResources(); applyFilters(); });
    carouselPinsClear?.addEventListener('click', () => { pinnedSlugs.clear(); persistPins(); renderPinnedResources(); applyFilters(); });
    resourcePinsClear?.addEventListener('click', () => { pinnedSlugs.clear(); persistPins(); renderPinnedResources(); applyFilters(); });
    const openPinnedResources = () => {
      if (!pinnedSlugs.size) return;
      const url = new URL(window.location.href);
      url.hash = '';
      url.searchParams.set('view', 'cards');
      url.searchParams.set('pageSize', 'all');
      url.searchParams.set('resources', [...pinnedSlugs].join(','));
      ['topic', 'type', 'institution'].forEach((key) => url.searchParams.delete(key));
      window.open(url.toString(), '_blank', 'noopener,noreferrer');
    };
    networkPinsOpen?.addEventListener('click', openPinnedResources);
    carouselPinsOpen?.addEventListener('click', openPinnedResources);
    if (networkPreviewDrag && networkPreview && networkStage) {
      let drag: { pointerId: number; offsetX: number; offsetY: number } | undefined;
      networkPreviewDrag.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.stopPropagation();
        const preview = networkPreview.getBoundingClientRect();
        const stage = networkStage.getBoundingClientRect();
        drag = { pointerId: event.pointerId, offsetX: event.clientX - preview.left, offsetY: event.clientY - preview.top };
        networkPreview.style.left = `${preview.left - stage.left}px`; networkPreview.style.top = `${preview.top - stage.top}px`;
        networkPreview.style.right = 'auto'; networkPreview.style.bottom = 'auto';
        networkPreview.classList.add('is-dragging');
        networkPreviewDrag.setPointerCapture(event.pointerId);
      });
      networkPreviewDrag.addEventListener('pointermove', (event) => {
        if (!drag || drag.pointerId !== event.pointerId) return;
        const stage = networkStage.getBoundingClientRect();
        const preview = networkPreview.getBoundingClientRect();
        const x = Math.max(8, Math.min(stage.width - preview.width - 8, event.clientX - stage.left - drag.offsetX));
        const y = Math.max(8, Math.min(stage.height - preview.height - 8, event.clientY - stage.top - drag.offsetY));
        networkPreview.style.left = `${x}px`; networkPreview.style.top = `${y}px`;
      });
      const finishPreviewDrag = (event: PointerEvent) => {
        if (!drag || drag.pointerId !== event.pointerId) return;
        const stage = networkStage.getBoundingClientRect();
        const preview = networkPreview.getBoundingClientRect();
        const maxX = Math.max(8, stage.width - preview.width - 8), maxY = Math.max(8, stage.height - preview.height - 8);
        const x = parseFloat(networkPreview.style.left) || 8, y = parseFloat(networkPreview.style.top) || 8;
        localStorage.setItem(previewStorageKey, JSON.stringify({ x: x / maxX, y: y / maxY }));
        networkPreview.classList.remove('is-dragging'); drag = undefined;
      };
      networkPreviewDrag.addEventListener('pointerup', finishPreviewDrag);
      networkPreviewDrag.addEventListener('pointercancel', finishPreviewDrag);
    }
    if (networkStage) new ResizeObserver(() => { window.cancelAnimationFrame(networkResizeFrame); networkResizeFrame = window.requestAnimationFrame(() => { if (explorerMode === 'network') renderNetwork(currentMatching); }); }).observe(networkStage);

    const carouselPointer = (event: PointerEvent) => {
      const bounds = carouselCanvas?.getBoundingClientRect();
      return bounds ? { x: event.clientX - bounds.left, y: event.clientY - bounds.top } : { x: 0, y: 0 };
    };
    const nearestCarouselParticle = (x: number, y: number, maximum = 28) => {
      let nearest: CarouselParticle | undefined;
      let distance = maximum;
      carouselParticles.forEach((particle) => { const next = Math.hypot(particle.x - x, particle.y - y); if (next < distance) { nearest = particle; distance = next; } });
      return nearest;
    };
    carouselCanvas?.addEventListener('pointermove', (event) => {
      const point = carouselPointer(event);
      if (!carouselPointerActive) {
        carouselHovered = nearestCarouselParticle(point.x, point.y, 24);
        if (carouselTooltip) {
          carouselTooltip.hidden = !carouselHovered;
          if (carouselHovered) { carouselTooltip.textContent = carouselHovered.card.dataset.title || ''; carouselTooltip.style.left = `${Math.min(carouselWidth - 250, point.x + 13)}px`; carouselTooltip.style.top = `${Math.max(8, point.y - 38)}px`; }
        }
        drawCarousel();
        return;
      }
      if (Math.hypot(point.x - carouselDragStart.x, point.y - carouselDragStart.y) > 7) carouselDragged = true;
      const normalizedX = (point.x - carouselWidth * .5) / Math.max(1, carouselWidth * .38);
      const normalizedY = (point.y - carouselHeight * .5) / Math.max(1, carouselHeight * .3);
      const nextAngle = Math.atan2(normalizedY, normalizedX);
      let angleDelta = nextAngle - carouselPreviousAngle;
      if (angleDelta > Math.PI) angleDelta -= Math.PI * 2;
      if (angleDelta < -Math.PI) angleDelta += Math.PI * 2;
      if (Math.abs(angleDelta) > .002) carouselTargetRotation = Math.max(-3, Math.min(3, angleDelta * 80));
      const verticalDelta = point.y - carouselPreviousY;
      if (Math.abs(verticalDelta) > .15) carouselTargetVerticalDrift = Math.max(-2.2, Math.min(2.2, verticalDelta * .09));
      carouselPreviousAngle = nextAngle;
      carouselPreviousY = point.y;
    });
    carouselCanvas?.addEventListener('pointerdown', (event) => {
      const point = carouselPointer(event);
      carouselPointerActive = true; carouselDragged = false; carouselDragStart = point;
      carouselPreviousAngle = Math.atan2((point.y - carouselHeight * .5) / Math.max(1, carouselHeight * .3), (point.x - carouselWidth * .5) / Math.max(1, carouselWidth * .38));
      carouselPreviousY = point.y;
      carouselCanvas.setPointerCapture(event.pointerId); carouselCanvas.classList.add('is-dragging');
      event.preventDefault();
    });
    const finishCarouselPointer = (event: PointerEvent) => {
      if (!carouselCanvas || !carouselPointerActive) return;
      const point = carouselPointer(event);
      if (!carouselDragged) { const particle = nearestCarouselParticle(point.x, point.y, 30); if (particle) selectCarouselCard(particle.card); }
      carouselPointerActive = false; carouselCanvas.classList.remove('is-dragging');
      if (carouselCanvas.hasPointerCapture(event.pointerId)) carouselCanvas.releasePointerCapture(event.pointerId);
    };
    carouselCanvas?.addEventListener('pointerup', finishCarouselPointer);
    carouselCanvas?.addEventListener('pointercancel', finishCarouselPointer);
    carouselCanvas?.addEventListener('pointerleave', () => { if (!carouselPointerActive) { carouselHovered = undefined; if (carouselTooltip) carouselTooltip.hidden = true; drawCarousel(); } });
    carouselPreviewPin?.addEventListener('click', () => { if (selectedCarouselCard) togglePinnedResource(selectedCarouselCard); });
    root.querySelector('[data-carousel-preview-close]')?.addEventListener('click', clearCarouselSelection);
    if (carouselStage) new ResizeObserver(() => { if (root.dataset.view === 'explore' && explorerMode === 'carousel') renderCarousel(currentMatching); }).observe(carouselStage);
    new MutationObserver(drawCarousel).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    carouselReducedMotion.addEventListener('change', startCarousel);

    const viewFragments = { cards: 'rezgis', list: 'saraksts', network: 'resursu-tikls', carousel: 'resursu-karuselis' } as const;
    const legacyCardsFragment = 'kartites';
    const currentViewFragment = () => root.dataset.view === 'explore' ? viewFragments[explorerMode] : root.dataset.view === 'list' ? viewFragments.list : viewFragments.cards;
    const updateViewFragment = () => history.replaceState(null, '', `${window.location.pathname}${window.location.search}#${currentViewFragment()}`);
    const setExplorerMode = (mode: 'network' | 'carousel', updateHash = true) => {
      explorerMode = mode;
      explorerModeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.explorerMode === mode)));
      if (networkPanel) networkPanel.hidden = mode !== 'network';
      if (carouselPanel) carouselPanel.hidden = mode !== 'carousel';
      if (mode === 'network') { stopCarousel(); requestAnimationFrame(() => renderNetwork(currentMatching)); }
      else { window.cancelAnimationFrame(graphAnimationFrame); requestAnimationFrame(() => renderCarousel(currentMatching)); }
      localStorage.setItem('dh-resource-explorer-mode', mode);
      if (updateHash && root.dataset.view === 'explore') updateViewFragment();
    };
    explorerModeButtons.forEach((button) => button.addEventListener('click', () => setExplorerMode(button.dataset.explorerMode === 'carousel' ? 'carousel' : 'network')));

    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-resource-view]')];
    const setView = (view: 'cards' | 'list' | 'explore', updateHash = true) => {
      root.dataset.view = view;
      viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.resourceView === view)));
      if (explorer) explorer.hidden = view !== 'explore';
      if (view !== 'explore') { window.cancelAnimationFrame(graphAnimationFrame); stopCarousel(); }
      if (pagination) pagination.hidden = view === 'explore';
      if (pageSizeSelect?.closest('label')) (pageSizeSelect.closest('label') as HTMLElement).hidden = view === 'explore';
      if (view === 'explore') requestAnimationFrame(() => explorerMode === 'carousel' ? renderCarousel(currentMatching) : renderNetwork(currentMatching));
      localStorage.setItem('dh-resource-view', view);
      if (updateHash) updateViewFragment();
    };
    viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.resourceView === 'list' ? 'list' : button.dataset.resourceView === 'explore' ? 'explore' : 'cards')));
    const urlParameters = initialUrlParameters;
    const requestedView = urlParameters.get('view');
    const savedView = localStorage.getItem('dh-resource-view');
    const initialFragment = decodeURIComponent(window.location.hash.slice(1));
    const fragmentView = initialFragment === viewFragments.cards || initialFragment === legacyCardsFragment ? 'cards' : initialFragment === viewFragments.list ? 'list' : initialFragment === viewFragments.network || initialFragment === viewFragments.carousel ? 'explore' : undefined;
    const fragmentExplorerMode = initialFragment === viewFragments.carousel ? 'carousel' : initialFragment === viewFragments.network ? 'network' : undefined;
    setExplorerMode(fragmentExplorerMode || (localStorage.getItem('dh-resource-explorer-mode') === 'carousel' ? 'carousel' : 'network'), false);
    setView(fragmentView || (requestedView === 'cards' || requestedView === 'list' || requestedView === 'explore' ? requestedView : savedView === 'list' || savedView === 'explore' ? savedView : 'cards'), false);
    if (fragmentView) updateViewFragment();
    const savedPageSize = localStorage.getItem('dh-resource-page-size');
    const requestedPageSize = urlParameters.get('pageSize');
    const initialPageSize = requestedPageSize && ['12', '24', '48', 'all'].includes(requestedPageSize) ? requestedPageSize : savedPageSize;
    if (pageSizeSelect && initialPageSize && ['12', '24', '48', 'all'].includes(initialPageSize)) {
      pageSizeSelect.value = initialPageSize;
      pageSize = initialPageSize === 'all' ? Infinity : Number(initialPageSize);
    }
    const requestedTopic = urlParameters.get('topic');
    const requestedType = urlParameters.get('type');
    const requestedInstitution = urlParameters.get('institution');
    if (requestedTopic) topicInputs.forEach((input) => input.checked = input.value === requestedTopic);
    if (requestedType) typeInputs.forEach((input) => input.checked = input.value === requestedType);
    if (requestedInstitution) creatorInputs.forEach((input) => input.checked = input.value === requestedInstitution);
    cards.forEach((card) => card.addEventListener('pointermove', (event) => { const rect = card.getBoundingClientRect(); card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`); card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`); }));
    const openResourceDetail = (card: HTMLElement, updateHash = true) => {
      const template = card.querySelector<HTMLTemplateElement>('[data-resource-detail]');
      if (!template || !detailContent || !detailDialog) return;
      detailContent.replaceChildren(template.content.cloneNode(true));
      detailContent.querySelector('h2')?.setAttribute('id', 'resource-detail-title');
      const slug = card.dataset.slug || '';
      detailContent.querySelector<HTMLButtonElement>('[data-copy-resource-link]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        await navigator.clipboard.writeText(window.location.href);
        const label = button.querySelector('span');
        if (label) label.textContent = button.dataset.copiedLabel || '';
        window.setTimeout(() => { if (label) label.textContent = button.dataset.defaultLabel || ''; }, 1800);
      });
      if (updateHash && slug) history.replaceState(null, '', `#${encodeURIComponent(slug)}`);
      detailDialog.showModal();
    };
    const closeResourceDetail = (clearHash = true) => {
      if (detailDialog?.open) detailDialog.close();
      if (clearHash) updateViewFragment();
    };
    cards.forEach((card) => {
      card.querySelector('[data-open-resource-detail]')?.addEventListener('click', () => openResourceDetail(card));
      card.querySelector('[data-resource-pin]')?.addEventListener('click', () => togglePinnedResource(card));
    });
    root.querySelector('[data-resource-dialog-close]')?.addEventListener('click', () => closeResourceDetail());
    detailDialog?.addEventListener('click', (event) => { if (event.target === detailDialog) closeResourceDetail(); });
    detailDialog?.addEventListener('close', updateViewFragment);
    const openHashResource = () => {
      const slug = decodeURIComponent(window.location.hash.slice(1));
      if (!slug) return;
      const card = cards.find((item) => item.dataset.slug === slug);
      if (card) openResourceDetail(card, false);
    };
    window.addEventListener('hashchange', () => {
      const fragment = decodeURIComponent(window.location.hash.slice(1));
      if (fragment === viewFragments.cards || fragment === legacyCardsFragment) setView('cards', false);
      else if (fragment === viewFragments.list) setView('list', false);
      else if (fragment === viewFragments.network) { setExplorerMode('network', false); setView('explore', false); }
      else if (fragment === viewFragments.carousel) { setExplorerMode('carousel', false); setView('explore', false); }
      else openHashResource();
    });
    renderPinnedResources();
    applyFilters();
    openHashResource();
  }
</script>
