---
import { Check, ChevronDown, Database, ExternalLink, Filter, Focus, Grid2X2, Link2, List, Network, Orbit, Pause, Pin, Play, Plus, RotateCcw, Search, SlidersHorizontal, X, ZoomIn, ZoomOut } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBackLink from './HomeBackLink.astro';
import resourceData from '../data/resources.json';
import institutionData from '../data/institutions.json';

interface Props { lang: 'lv' | 'en'; }
interface ResourceRecord {
  translation_id: string;
  language: 'lv' | 'en';
  slug: string;
  title: string;
  long_title?: string;
  summary?: string;
  description?: string;
  website_url?: string;
  image_url?: string;
  image_alt?: string;
  creator?: string;
  institutions?: string;
  creator_people?: string;
  creator_codes?: string;
  type_repository?: boolean;
  type_dataset?: boolean;
  type_tool?: boolean;
  type_participation?: boolean;
  topic_history?: boolean;
  topic_literature?: boolean;
  topic_language?: boolean;
  topic_folklore?: boolean;
  topic_visual_arts?: boolean;
  topic_performing_arts?: boolean;
  access_model?: string;
  content_languages?: string;
  license?: string;
  last_checked?: string;
  research_readiness?: string;
  reuse_readiness?: string;
}

const { lang } = Astro.props;
const lv = lang === 'lv';
const resources = (resourceData as ResourceRecord[]).filter((item) => item.language === lang);
const institutionLabels = institutionData
  .map((item) => lang === 'lv' ? item.lv : item.en)
  .sort((a, b) => b.length - a.length);
const splitInstitutions = (value = '') => {
  let remaining = value.trim();
  const matches: string[] = [];
  for (const label of institutionLabels) {
    const index = remaining.toLocaleLowerCase(lang).indexOf(label.toLocaleLowerCase(lang));
    if (index < 0) continue;
    matches.push(label);
    remaining = `${remaining.slice(0, index)} ${remaining.slice(index + label.length)}`;
  }
  return matches.length
    ? matches
    : value.split(/\s*;\s*/).map((item) => item.trim()).filter(Boolean);
};
const universityLabel = lv ? 'Latvijas Universitāte' : 'University of Latvia';
const creatorDefs = [...new Set([universityLabel, ...resources.flatMap((item) => splitInstitutions(item.institutions))])].sort((a, b) => a.localeCompare(b, lang));
const institutionCodeByLabel = new Map(institutionData.map((item) => [lang === 'lv' ? item.lv : item.en, item.code]));
const typeDefs = [
  ['repository', 'type_repository', lv ? 'Repozitoriji un digitālas publikācijas' : 'Repositories and digital publications'],
  ['dataset', 'type_dataset', lv ? 'Datu kopas' : 'Datasets'],
  ['tool', 'type_tool', lv ? 'Rīki un pakalpojumi' : 'Tools and services'],
  ['participation', 'type_participation', lv ? 'Virtuālā līdzdalība' : 'Virtual participation'],
] as const;
const topicDefs = [
  ['history', 'topic_history', lv ? 'Vēsture' : 'History'],
  ['literature', 'topic_literature', lv ? 'Literatūra' : 'Literature'],
  ['language', 'topic_language', lv ? 'Valoda' : 'Language'],
  ['folklore', 'topic_folklore', lv ? 'Folklora' : 'Folklore'],
  ['visual-arts', 'topic_visual_arts', lv ? 'Vizuālā māksla' : 'Visual arts'],
  ['performing-arts', 'topic_performing_arts', lv ? 'Skatuves māksla' : 'Performing arts'],
] as const;
const copy = lv ? {
  title: 'Resursi un rīki', lead: 'Digitālo humanitāro zinātņu resursi pētniecībai, mācībām un kultūras mantojuma izzināšanai.',
  search: 'Meklēt pēc nosaukuma, institūcijas vai apraksta…', filters: 'Filtri', close: 'Aizvērt filtrus', type: 'Resursa tips', topic: 'Temats',
  access: 'Piekļuve', allAccess: 'Jebkāda piekļuve', open: 'Brīva piekļuve', registration: 'Ar reģistrēšanos', restricted: 'Ierobežota', unknown: 'Nav norādīts',
  results: 'resursi', cards: 'Režģis', list: 'Saraksts', explore: 'Izpētīt', carousel: 'Karuselis', view: 'Mainīt skatu', sort: 'Kārtot', recommended: 'Nejauša secība', az: 'A–Z', za: 'Z–A',
  clear: 'Notīrīt', activeFilters: 'Aktīvie filtri', noResults: 'Neviens resurss neatbilst izvēlētajiem filtriem.', reset: 'Atiestatīt filtrus', openResource: 'Atvērt resursu',
  creator: 'Izstrādājis', creatorFilter: 'Institūcija', creatorSearch: 'Meklēt institūciju…', more: 'Rādīt vairāk', page: 'Lapa', previous: 'Iepriekšējā', next: 'Nākamā', of: 'no', database: 'Resursu datubāze', filterHint: 'Izvēlies vienu vai vairākus filtrus', perPage: 'Rādīt', itemsPerPage: 'vienā lapā', all: 'Visus', details: 'Atvērt pilnu aprakstu', copyLink: 'Kopēt saiti', copied: 'Saite nokopēta', networkTitle: 'Resursu saikņu tīkls', networkHint: 'Velc fonu, lai pārvietotos. Ritini vai izmanto pogas, lai tuvinātu. Klikšķini uz mezgla, lai izgaismotu tā saiknes.', networkHelp: 'Izvēlies resursa mezglu, lai apskatītu tā aprakstu un saiknes. Priekšskatījuma kartītē resursu vari piespraust. Piespraustie resursi tiek saglabāti Tavā pārlūkā, un visu atlasi vari atvērt kopā jaunā cilnē. Tīklu vari pārvietot, tuvināt un filtrēt pēc mezglu veida.', carouselTitle: 'Resursu karuselis', carouselHint: 'Katrs pikselis attēlo vienu resursu. Velc karuseli, lai mainītu griešanās virzienu, un izvēlies pikseli, lai atvērtu resursa informāciju.', carouselHelp: 'Katrs vienāda izmēra pikselis ir viens resurss. Velc karuseli horizontāli vai vertikāli, lai mainītu tā kustību. Izvēlies pikseli, lai apskatītu resursa informāciju un to piespraustu.', zoomIn: 'Tuvināt', zoomOut: 'Tālināt', resetView: 'Centrēt tīklu', networkPause: 'Apturēt kustību', networkResume: 'Turpināt kustību', resourceNode: 'Resurss', typeNode: 'Resursa tips', topicNode: 'Temats', institutionNode: 'Institūcija', networkLayers: 'Rādīt tīklā', networkExpand: 'Izvērst', networkViewAll: 'Aplūkot visus jaunā cilnē', networkRelated: 'saistīti resursi', networkClose: 'Aizvērt priekšskatījumu', networkPin: 'Piespraust', networkUnpin: 'Atspraust', pinnedTitle: 'Piespraustie resursi', pinnedOpen: 'Aplūkot atlasi jaunā cilnē', pinnedClear: 'Notīrīt atlasi', cardPinsClear: 'Noņemt visas piespraudes', previewDrag: 'Velc, lai pārvietotu kartīti',
} : {
  title: 'Resources and tools', lead: 'Digital humanities resources for research, teaching and exploring cultural heritage.',
  search: 'Search by title, institution or description…', filters: 'Filters', close: 'Close filters', type: 'Resource type', topic: 'Topic',
  access: 'Access', allAccess: 'Any access', open: 'Open access', registration: 'Registration required', restricted: 'Restricted', unknown: 'Not specified',
  results: 'resources', cards: 'Cards', list: 'List', explore: 'Explore', carousel: 'Carousel', view: 'Change view', sort: 'Sort', recommended: 'Random order', az: 'A–Z', za: 'Z–A',
  clear: 'Clear', activeFilters: 'Active filters', noResults: 'No resources match the selected filters.', reset: 'Reset filters', openResource: 'Open resource',
  creator: 'Developed by', creatorFilter: 'Institution', creatorSearch: 'Search institutions…', more: 'Show more', page: 'Page', previous: 'Previous', next: 'Next', of: 'of', database: 'Resource database', filterHint: 'Choose one or more filters', perPage: 'Show', itemsPerPage: 'per page', all: 'All', details: 'Open full description', copyLink: 'Copy link', copied: 'Link copied', networkTitle: 'Resource connections', networkHint: 'Drag the background to move. Scroll or use the controls to zoom. Select a node to illuminate its connections.', networkHelp: 'Select a resource node to view its description and connections. You can pin a resource from its preview card. Pinned resources are saved in your browser, and you can open the full selection together in a new tab. The network can be moved, zoomed and filtered by node type.', carouselTitle: 'Resource carousel', carouselHint: 'Each pixel represents one resource. Drag the carousel to change its direction, and select a pixel to open the resource information.', carouselHelp: 'Each equally sized pixel represents one resource. Drag the carousel horizontally or vertically to change its motion. Select a pixel to view the resource information and pin it.', zoomIn: 'Zoom in', zoomOut: 'Zoom out', resetView: 'Centre network', networkPause: 'Pause motion', networkResume: 'Resume motion', resourceNode: 'Resource', typeNode: 'Resource type', topicNode: 'Topic', institutionNode: 'Institution', networkLayers: 'Show in network', networkExpand: 'Expand', networkViewAll: 'View all in a new tab', networkRelated: 'related resources', networkClose: 'Close preview', networkPin: 'Pin', networkUnpin: 'Unpin', pinnedTitle: 'Pinned resources', pinnedOpen: 'View selection in a new tab', pinnedClear: 'Clear selection', cardPinsClear: 'Remove all pins', previewDrag: 'Drag to move this card',
};
const normalize = (value = '') => value.toLocaleLowerCase(lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const accessLabel = (value = '') => {
  const key = normalize(value);
  if (!key) return '';
  if (key.includes('open') || key.includes('briv')) return copy.open;
  if (key.includes('regist')) return copy.registration;
  if (key.includes('restrict') || key.includes('ierob')) return copy.restricted;
  return value;
};
---
<BaseLayout title={`${copy.title} – digitalhumanities.lv`} description={copy.lead} lang={lang} alternateUrl={lv ? '/en/resources-and-tools/' : '/lv/resursi-un-riki/'}>
  <div class="resources-page" data-resource-directory data-view="cards" data-page-size="24">
    <section class="page-heading resources-heading shell">
      <HomeBackLink lang={lang} />
      <div class="resources-heading-grid"><div><p class="section-label">{copy.database}</p><h1>{copy.title}</h1></div><p class="lead">{copy.lead}</p></div>
    </section>

    <section class="resources-directory shell">
      <div class="resources-topbar">
        <label class="resource-search"><Search size={20} /><span class="sr-only">{copy.search}</span><input type="search" placeholder={copy.search} data-resource-search /></label>
        <button class="resource-filter-toggle" type="button" aria-expanded="false" data-filter-toggle><Filter size={18} /><span>{copy.filters}</span><span class="resource-filter-count" data-filter-count hidden>0</span></button>
        <label class="resource-sort"><span>{copy.sort}</span><select data-resource-sort><option value="random">{copy.recommended}</option><option value="az">{copy.az}</option><option value="za">{copy.za}</option></select><ChevronDown size={15} /></label>
        <div class="resource-view-toggle" aria-label={copy.view}>
          <button type="button" data-resource-view="cards" aria-pressed="true" title={copy.cards}><Grid2X2 size={17} /><span>{copy.cards}</span></button>
          <button type="button" data-resource-view="list" aria-pressed="false" title={copy.list}><List size={18} /><span>{copy.list}</span></button>
          <button type="button" data-resource-view="explore" aria-pressed="false" title={copy.explore}><Network size={18} /><span>{copy.explore}</span></button>
        </div>
      </div>

      <div class="resource-workspace">
        <aside class="resource-filters" data-resource-filters>
          <div class="resource-filter-heading"><div><SlidersHorizontal size={17} /><strong>{copy.filters}</strong><small>{copy.filterHint}</small></div><button type="button" data-filter-close aria-label={copy.close}><X size={20} /></button></div>
          <fieldset><legend>{copy.type}</legend><div class="resource-filter-options">{typeDefs.map(([value,, label]) => <label><input type="checkbox" value={value} data-resource-type /><span><Check size={13} />{label}</span></label>)}</div></fieldset>
          <fieldset><legend>{copy.topic}</legend><div class="resource-filter-options">{topicDefs.map(([value,, label]) => <label><input type="checkbox" value={value} data-resource-topic /><span><Check size={13} />{label}</span></label>)}</div></fieldset>
          <fieldset><legend>{copy.creatorFilter}</legend>
            <label class="resource-creator-search"><Search size={15} /><span class="sr-only">{copy.creatorSearch}</span><input type="search" placeholder={copy.creatorSearch} data-creator-search /></label>
            <div class="resource-filter-options resource-creator-options" data-creator-options>{creatorDefs.map((label) => <label data-creator-option><input type="checkbox" value={normalize(label)} data-institution-code={institutionCodeByLabel.get(label) || ''} data-resource-creator /><span><Check size={13} />{label}</span></label>)}</div>
          </fieldset>
          <fieldset><legend>{copy.access}</legend>
            <div class="resource-access-select" data-access-menu>
              <select data-resource-access hidden aria-hidden="true"><option value="all">{copy.allAccess}</option><option value="open">{copy.open}</option><option value="registration">{copy.registration}</option><option value="restricted">{copy.restricted}</option><option value="unknown">{copy.unknown}</option></select>
              <button class="resource-access-trigger" type="button" aria-expanded="false" data-access-trigger><span data-access-label>{copy.allAccess}</span><ChevronDown size={15} /></button>
              <div class="resource-access-options" data-access-options hidden>
                {[
                  ['all', copy.allAccess], ['open', copy.open], ['registration', copy.registration], ['restricted', copy.restricted], ['unknown', copy.unknown],
                ].map(([value, label]) => <button type="button" data-access-option data-value={value} aria-pressed={value === 'all' ? 'true' : 'false'}><span class="resource-access-option-mark"></span><span>{label}</span><Check size={14} /></button>)}
              </div>
            </div>
          </fieldset>
          <button class="resource-clear" type="button" data-resource-clear><RotateCcw size={15} />{copy.clear}</button>
        </aside>

        <div class="resource-results">
          <div class="resource-results-head">
            <div class="resource-results-meta">
              <p><strong data-resource-count>{resources.length}</strong> {copy.results}</p>
              <label class="resource-page-size"><span>{copy.perPage}</span><select data-page-size-select><option value="12">12</option><option value="24" selected>24</option><option value="48">48</option><option value="all">{copy.all}</option></select><ChevronDown size={14} /><span>{copy.itemsPerPage}</span></label>
              <button class="resource-clear-pins" type="button" data-resource-pins-clear hidden><Pin size={14} aria-hidden="true" />{copy.cardPinsClear}</button>
            </div>
            <div class="resource-active-filters" aria-label={copy.activeFilters} data-active-filters></div>
          </div>
          <div class="resource-list" data-resource-list>
            {resources.map((resource, index) => {
              const types = typeDefs.filter(([, key]) => resource[key]).map(([value,, label]) => ({ value, label }));
              const topics = topicDefs.filter(([, key]) => resource[key]).map(([value,, label]) => ({ value, label }));
              const access = accessLabel(resource.access_model);
              const accessKey = access === copy.open ? 'open' : access === copy.registration ? 'registration' : access === copy.restricted ? 'restricted' : 'unknown';
  const creator = (resource.creator || '')
    .trim()
    .replace(/^["'“”„«»]+\s*|\s*["'“”„«»]+$/g, '')
    .trim();
              const institutions = splitInstitutions(resource.institutions);
              const searchText = normalize([resource.title, resource.long_title, resource.summary, resource.description, creator, ...types.map((item) => item.label), ...topics.map((item) => item.label)].join(' '));
              const creators = institutions.map((institution) => normalize(institution));
              return <article class="resource-card" data-resource data-slug={resource.slug} data-title={resource.title} data-index={index} data-search={searchText} data-types={types.map((item) => item.value).join(' ')} data-topics={topics.map((item) => item.value).join(' ')} data-creators={JSON.stringify(creators)} data-creator-codes={resource.creator_codes || ''} data-access={accessKey}>
                {resource.image_url && <div class="resource-card-visual" aria-hidden="true"><img src={resource.image_url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>}
                <button class="resource-card-pin" type="button" data-resource-pin data-pin-label={copy.networkPin} data-unpin-label={copy.networkUnpin} aria-label={`${copy.networkPin}: ${resource.title}`} title={copy.networkPin} aria-pressed="false"><Pin size={16} aria-hidden="true" /></button>
                <button class="resource-card-main" type="button" data-open-resource-detail aria-label={`${copy.details}: ${resource.title}`}>
                  <div class="resource-card-body">
                    {access && <div class="resource-card-meta"><span class="resource-access"><i></i>{access}</span></div>}
                    <h2>{resource.title}</h2>
                    <p class="resource-summary">{resource.summary || resource.description}</p>
                    <div class="resource-taxonomy">
                      <div class="resource-type-tags">{types.map(({ value, label }) => <span data-kind={value}>{label}</span>)}</div>
                      <div class="resource-topic-tags">{topics.map(({ value, label }) => <span data-kind={value}>{label}</span>)}</div>
                    </div>
                  </div>
                  <span class="resource-open" aria-hidden="true"><Plus size={18} /></span>
                </button>
                <template data-resource-detail>
                  <div class="resource-detail-layout">
                    {resource.image_url && <figure class="resource-detail-image">
                      <img class="resource-detail-image-backdrop" src={resource.image_url} alt="" aria-hidden="true" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                      <img class="resource-detail-image-main" src={resource.image_url} alt={resource.image_alt || ''} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    </figure>}
                    <div class="resource-detail-copy">
                      {access && <p class="resource-access"><i></i>{access}</p>}
                      <h2>{resource.title}</h2>
                      {resource.long_title && resource.long_title !== resource.title && <p class="resource-detail-long-title">{resource.long_title}</p>}
          {creator && <p class="resource-detail-creator"><span>{copy.creator}</span>{creator}</p>}
                      <div class="resource-detail-description"><p>{resource.description || resource.summary}</p></div>
                      <div class="resource-taxonomy"><div class="resource-type-tags">{types.map(({ value, label }) => <span data-kind={value}>{label}</span>)}</div><div class="resource-topic-tags">{topics.map(({ value, label }) => <span data-kind={value}>{label}</span>)}</div></div>
                      <div class="resource-detail-actions">
                        {resource.website_url && <a class="button primary" href={resource.website_url} target="_blank" rel="noreferrer">{copy.openResource}<ExternalLink size={16} /></a>}
                        <button class="button secondary" type="button" data-copy-resource-link data-default-label={copy.copyLink} data-copied-label={copy.copied}><Link2 size={16} /><span>{copy.copyLink}</span></button>
                      </div>
                    </div>
                  </div>
                </template>
              </article>;
            })}
          </div>
          <section class="resource-explorer" data-resource-explorer hidden aria-label={copy.networkTitle}>
            <div class="resource-explorer-switch" aria-label={copy.explore}>
              <button type="button" data-explorer-mode="network" aria-pressed="true"><Network size={17} />{copy.networkTitle}</button>
              <button type="button" data-explorer-mode="carousel" aria-pressed="false"><Orbit size={17} />{copy.carouselTitle}</button>
            </div>
            <div data-resource-network-panel>
            <div class="resource-explorer-head">
              <div class="resource-network-heading"><strong>{copy.networkTitle}</strong><span><b data-network-count>{resources.length}</b> {copy.results}</span></div>
              <fieldset class="resource-network-layers" data-network-layers>
                <legend>{copy.networkLayers}</legend>
                <label><input type="checkbox" value="resource" checked /><span data-kind="resource"><i></i>{copy.resourceNode}</span></label>
                <label><input type="checkbox" value="type" checked /><span data-kind="type"><i></i>{copy.typeNode}</span></label>
                <label><input type="checkbox" value="topic" checked /><span data-kind="topic"><i></i>{copy.topicNode}</span></label>
                <label><input type="checkbox" value="institution" checked /><span data-kind="institution"><i></i>{copy.institutionNode}</span></label>
              </fieldset>
              <div class="resource-network-controls">
                <button type="button" data-network-motion data-pause-label={copy.networkPause} data-resume-label={copy.networkResume} aria-label={copy.networkPause} title={copy.networkPause} aria-pressed="false"><span data-motion-pause><Pause size={18} /></span><span data-motion-play hidden><Play size={18} /></span></button>
                <button type="button" data-network-zoom-out aria-label={copy.zoomOut} title={copy.zoomOut}><ZoomOut size={18} /></button>
                <button type="button" data-network-reset aria-label={copy.resetView} title={copy.resetView}><Focus size={18} /></button>
                <button type="button" data-network-zoom-in aria-label={copy.zoomIn} title={copy.zoomIn}><ZoomIn size={18} /></button>
              </div>
            </div>
            <div class="resource-network-stage" data-network-stage>
              <svg data-resource-network role="img" aria-label={copy.networkHint}></svg>
              <div class="resource-network-tooltip" data-network-tooltip hidden></div>
              <article class="resource-network-preview" data-network-preview hidden>
                <button type="button" data-network-preview-pin data-pin-label={copy.networkPin} data-unpin-label={copy.networkUnpin} hidden aria-label={copy.networkPin} title={copy.networkPin} aria-pressed="false"><Pin size={17} aria-hidden="true" /></button>
                <div class="resource-network-preview-head" data-network-preview-drag title={copy.previewDrag}>
                  <p data-network-preview-kind></p>
                  <span aria-hidden="true">⠿</span>
                </div>
                <button type="button" data-network-preview-close aria-label={copy.networkClose}>×</button>
                <h3 data-network-preview-title></h3>
                <p data-network-preview-summary></p>
                <div class="resource-network-preview-actions">
                  <button type="button" data-network-preview-expand><span data-network-preview-action-label>{copy.networkExpand}</span><span aria-hidden="true">↗</span></button>
                </div>
              </article>
              <aside class="resource-network-pins" data-network-pins hidden>
                <div class="resource-network-pins-head"><strong>{copy.pinnedTitle}</strong><span data-network-pin-count></span></div>
                <div class="resource-network-pin-list" data-network-pin-list></div>
                <div class="resource-network-pin-actions">
                  <button type="button" data-network-pins-open>{copy.pinnedOpen}<span aria-hidden="true">↗</span></button>
                  <button type="button" data-network-pins-clear>{copy.pinnedClear}</button>
                </div>
              </aside>
            </div>
            <div class="resource-network-help"><Pin size={18} aria-hidden="true" /><p>{copy.networkHelp}</p></div>
            </div>
            <div class="resource-carousel" data-resource-carousel-panel hidden>
              <div class="resource-carousel-heading"><strong>{copy.carouselTitle}</strong><span><b data-carousel-count>{resources.length}</b> {copy.results}</span></div>
              <div class="resource-carousel-stage" data-carousel-stage>
                <canvas data-resource-carousel role="img" aria-label={copy.carouselHint}></canvas>
                <div class="resource-network-tooltip resource-carousel-tooltip" data-carousel-tooltip hidden></div>
                <article class="resource-network-preview resource-carousel-preview" data-carousel-preview hidden>
                  <button type="button" data-carousel-preview-pin data-network-preview-pin data-pin-label={copy.networkPin} data-unpin-label={copy.networkUnpin} aria-label={copy.networkPin} title={copy.networkPin} aria-pressed="false"><Pin size={17} aria-hidden="true" /></button>
                  <div class="resource-network-preview-head"><p>{copy.resourceNode}</p><span aria-hidden="true">⠿</span></div>
                  <button type="button" data-carousel-preview-close data-network-preview-close aria-label={copy.networkClose}>×</button>
                  <h3 data-carousel-preview-title></h3>
                  <p data-carousel-preview-summary></p>
                  <div class="resource-network-preview-actions"><button type="button" data-carousel-preview-expand><span>{copy.networkExpand}</span><span aria-hidden="true">↗</span></button></div>
                </article>
                <aside class="resource-network-pins" data-carousel-pins hidden>
                  <div class="resource-network-pins-head"><strong>{copy.pinnedTitle}</strong><span data-carousel-pin-count></span></div>
                  <div class="resource-network-pin-list" data-carousel-pin-list></div>
                  <div class="resource-network-pin-actions">
                    <button type="button" data-carousel-pins-open>{copy.pinnedOpen}<span aria-hidden="true">↗</span></button>
                    <button type="button" data-carousel-pins-clear>{copy.pinnedClear}</button>
                  </div>
                </aside>
                <div class="sr-only" data-carousel-accessible-list></div>
              </div>
              <div class="resource-network-help"><Orbit size={18} aria-hidden="true" /><p>{copy.carouselHelp}</p></div>
            </div>
          </section>
          <div class="resource-empty" data-resource-empty hidden><Database size={34} /><h2>{copy.noResults}</h2><button class="button secondary" type="button" data-resource-reset>{copy.reset}</button></div>
          <nav class="resource-pagination" aria-label={copy.page} data-resource-pagination><button type="button" data-page-previous>{copy.previous}</button><p><span>{copy.page}</span> <strong data-page-current>1</strong> {copy.of} <strong data-page-total>1</strong></p><button type="button" data-page-next>{copy.next}</button></nav>
        </div>
      </div>
      <div class="resource-filter-scrim" data-filter-scrim></div>
    </section>
    <dialog class="resource-detail-dialog" data-resource-dialog aria-labelledby="resource-detail-title"><button class="resource-detail-close" type="button" data-resource-dialog-close aria-label={copy.close}><X size={22} /></button><div data-resource-dialog-content></div></dialog>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-resource-directory]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-resource-search]');
    const sort = root.querySelector<HTMLSelectElement>('[data-resource-sort]');
    const access = root.querySelector<HTMLSelectElement>('[data-resource-access]');
    const typeInputs = [...root.querySelectorAll<HTMLInputElement>('[data-resource-type]')];
    const topicInputs = [...root.querySelectorAll<HTMLInputElement>('[data-resource-topic]')];
    const creatorInputs = [...root.querySelectorAll<HTMLInputElement>('[data-resource-creator]')];
    const creatorSearch = root.querySelector<HTMLInputElement>('[data-creator-search]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-resource]')];
    const randomOrder = new WeakMap<HTMLElement, number>();
    cards.forEach((card) => randomOrder.set(card, Math.random()));
    const list = root.querySelector<HTMLElement>('[data-resource-list]');
    const count = root.querySelector<HTMLElement>('[data-resource-count]');
    const empty = root.querySelector<HTMLElement>('[data-resource-empty]');
    const activeFilters = root.querySelector<HTMLElement>('[data-active-filters]');
    const filterCount = root.querySelector<HTMLElement>('[data-filter-count]');
    const currentPageLabel = root.querySelector<HTMLElement>('[data-page-current]');
    const totalPageLabel = root.querySelector<HTMLElement>('[data-page-total]');
    const pagination = root.querySelector<HTMLElement>('[data-resource-pagination]');
    const previous = root.querySelector<HTMLButtonElement>('[data-page-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-page-next]');
    const pageSizeSelect = root.querySelector<HTMLSelectElement>('[data-page-size-select]');
    const detailDialog = root.querySelector<HTMLDialogElement>('[data-resource-dialog]');
    const detailContent = root.querySelector<HTMLElement>('[data-resource-dialog-content]');
    const filterToggle = root.querySelector<HTMLButtonElement>('[data-filter-toggle]');
    const filterPanel = root.querySelector<HTMLElement>('[data-resource-filters]');
    const accessMenu = root.querySelector<HTMLElement>('[data-access-menu]');
    const accessTrigger = root.querySelector<HTMLButtonElement>('[data-access-trigger]');
    const accessOptions = root.querySelector<HTMLElement>('[data-access-options]');
    const accessLabel = root.querySelector<HTMLElement>('[data-access-label]');
    const accessOptionButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-access-option]')];
    const explorer = root.querySelector<HTMLElement>('[data-resource-explorer]');
    const networkStage = root.querySelector<HTMLElement>('[data-network-stage]');
    const networkSvg = root.querySelector<SVGSVGElement>('[data-resource-network]');
    const networkTooltip = root.querySelector<HTMLElement>('[data-network-tooltip]');
    const networkPreview = root.querySelector<HTMLElement>('[data-network-preview]');
    const networkPreviewKind = root.querySelector<HTMLElement>('[data-network-preview-kind]');
    const networkPreviewTitle = root.querySelector<HTMLElement>('[data-network-preview-title]');
    const networkPreviewSummary = root.querySelector<HTMLElement>('[data-network-preview-summary]');
    const networkPreviewExpand = root.querySelector<HTMLButtonElement>('[data-network-preview-expand]');
    const networkPreviewActionLabel = root.querySelector<HTMLElement>('[data-network-preview-action-label]');
    const networkPreviewDrag = root.querySelector<HTMLElement>('[data-network-preview-drag]');
    const networkPreviewPin = root.querySelector<HTMLButtonElement>('[data-network-preview-pin]');
    const networkPreviewPinLabel = root.querySelector<HTMLElement>('[data-network-preview-pin-label]');
    const networkPins = root.querySelector<HTMLElement>('[data-network-pins]');
    const networkPinList = root.querySelector<HTMLElement>('[data-network-pin-list]');
    const networkPinCount = root.querySelector<HTMLElement>('[data-network-pin-count]');
    const networkPinsOpen = root.querySelector<HTMLButtonElement>('[data-network-pins-open]');
    const networkPinsClear = root.querySelector<HTMLButtonElement>('[data-network-pins-clear]');
    const resourcePinsClear = root.querySelector<HTMLButtonElement>('[data-resource-pins-clear]');
    const networkCount = root.querySelector<HTMLElement>('[data-network-count]');
    const networkLayerInputs = [...root.querySelectorAll<HTMLInputElement>('[data-network-layers] input')];
    const networkPanel = root.querySelector<HTMLElement>('[data-resource-network-panel]');
    const carouselPanel = root.querySelector<HTMLElement>('[data-resource-carousel-panel]');
    const explorerModeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-explorer-mode]')];
    const carouselStage = root.querySelector<HTMLElement>('[data-carousel-stage]');
    const carouselCanvas = root.querySelector<HTMLCanvasElement>('[data-resource-carousel]');
    const carouselContext = carouselCanvas?.getContext('2d') || null;
    const carouselTooltip = root.querySelector<HTMLElement>('[data-carousel-tooltip]');
    const carouselPreview = root.querySelector<HTMLElement>('[data-carousel-preview]');
    const carouselPreviewTitle = root.querySelector<HTMLElement>('[data-carousel-preview-title]');
    const carouselPreviewSummary = root.querySelector<HTMLElement>('[data-carousel-preview-summary]');
    const carouselPreviewExpand = root.querySelector<HTMLButtonElement>('[data-carousel-preview-expand]');
    const carouselPreviewPin = root.querySelector<HTMLButtonElement>('[data-carousel-preview-pin]');
    const carouselPins = root.querySelector<HTMLElement>('[data-carousel-pins]');
    const carouselPinList = root.querySelector<HTMLElement>('[data-carousel-pin-list]');
    const carouselPinCount = root.querySelector<HTMLElement>('[data-carousel-pin-count]');
    const carouselPinsOpen = root.querySelector<HTMLButtonElement>('[data-carousel-pins-open]');
    const carouselPinsClear = root.querySelector<HTMLButtonElement>('[data-carousel-pins-clear]');
    const carouselCount = root.querySelector<HTMLElement>('[data-carousel-count]');
    const carouselAccessibleList = root.querySelector<HTMLElement>('[data-carousel-accessible-list]');
    let pageSize = Number(root.dataset.pageSize) || 24;
    let currentPage = 1;
    let currentMatching = [...cards];
    const initialUrlParameters = new URLSearchParams(window.location.search);
    const requestedResourceSlugs = new Set((initialUrlParameters.get('resources') || '').split(',').map((value) => value.trim()).filter(Boolean));
    const pinStorageKey = 'dh-resource-pins';
    const previewStorageKey = 'dh-resource-preview-position';
    const knownSlugs = new Set(cards.map((card) => card.dataset.slug || '').filter(Boolean));
    const readPins = () => {
      try {
        const parsed = JSON.parse(localStorage.getItem(pinStorageKey) || '[]');
        return Array.isArray(parsed) ? parsed.filter((value): value is string => typeof value === 'string' && knownSlugs.has(value)) : [];
      } catch { return []; }
    };
    const pinnedSlugs = new Set(readPins());
    let selectedPreviewCard: HTMLElement | undefined;
    let selectedCarouselCard: HTMLElement | undefined;
    let explorerMode: 'network' | 'carousel' = 'network';

    const selectedValues = (inputs: HTMLInputElement[]) => inputs.filter((input) => input.checked).map((input) => input.value);
    const labelFor = (input: HTMLInputElement) => input.closest('label')?.textContent?.trim() || input.value;
    type InstitutionFilter = { value: string; code: string };
    const selectedInstitutionFilters = (): InstitutionFilter[] => creatorInputs
      .filter((input) => input.checked)
      .map((input) => ({ value: input.value, code: input.dataset.institutionCode || '' }));
    const cardMatchesInstitution = (card: HTMLElement, filter: InstitutionFilter) => {
      const cardCreators = JSON.parse(card.dataset.creators || '[]') as string[];
      const cardCreatorCodes = (card.dataset.creatorCodes || '').split(/[|;,]/).map((value) => value.trim().toLowerCase()).filter(Boolean);
      if (filter.code === 'lu') {
        return cardCreatorCodes.some((item) => item === 'lu' || item.startsWith('lu-'))
          || cardCreators.some((item) => item === filter.value || item.startsWith('lu ') || item.startsWith('university of latvia '));
      }
      return cardCreators.includes(filter.value) || Boolean(filter.code && cardCreatorCodes.includes(filter.code));
    };
    const closeFilters = () => { root.classList.remove('filters-open'); filterToggle?.setAttribute('aria-expanded', 'false'); };
    const renderActiveFilters = () => {
      if (!activeFilters) return;
      activeFilters.replaceChildren();
      const selected = [...typeInputs, ...topicInputs, ...creatorInputs].filter((input) => input.checked);
      selected.forEach((input) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.innerHTML = `<span>${labelFor(input)}</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m18 6-12 12M6 6l12 12"/></svg>`;
        button.addEventListener('click', () => { input.checked = false; applyFilters(true); });
        activeFilters.append(button);
      });
      const filterTotal = selected.length + (access?.value && access.value !== 'all' ? 1 : 0);
      if (filterCount) { filterCount.textContent = String(filterTotal); filterCount.hidden = filterTotal === 0; }
    };
    const applyFilters = (resetPage = false) => {
      if (resetPage) currentPage = 1;
      const query = (search?.value || '').trim().toLocaleLowerCase(document.documentElement.lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const types = selectedValues(typeInputs);
      const topics = selectedValues(topicInputs);
      const creators = creatorInputs.filter((input) => input.checked).map((input) => ({ value: input.value, code: input.dataset.institutionCode || '' }));
      const accessValue = access?.value || 'all';
      const matching = cards.filter((card) => {
        const cardTypes = (card.dataset.types || '').split(' ');
        const cardTopics = (card.dataset.topics || '').split(' ');
        const creatorMatch = !creators.length || creators.some((creator) => cardMatchesInstitution(card, creator));
        return (!requestedResourceSlugs.size || requestedResourceSlugs.has(card.dataset.slug || '')) && (!query || card.dataset.search?.includes(query)) && (!types.length || types.some((value) => cardTypes.includes(value))) && (!topics.length || topics.some((value) => cardTopics.includes(value))) && creatorMatch && (accessValue === 'all' || card.dataset.access === accessValue);
      });
      currentMatching = matching;
      const direction = sort?.value || 'random';
      matching.sort((a, b) => {
        const pinDifference = Number(pinnedSlugs.has(b.dataset.slug || '')) - Number(pinnedSlugs.has(a.dataset.slug || ''));
        if (pinDifference) return pinDifference;
        return direction === 'az' ? (a.dataset.title || '').localeCompare(b.dataset.title || '', document.documentElement.lang) : direction === 'za' ? (b.dataset.title || '').localeCompare(a.dataset.title || '', document.documentElement.lang) : (randomOrder.get(a) || 0) - (randomOrder.get(b) || 0);
      });
      matching.forEach((card) => list?.append(card));
      const showAll = pageSize === Infinity;
      const totalPages = showAll ? 1 : Math.max(1, Math.ceil(matching.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      cards.forEach((card) => card.hidden = true);
      const visibleCards = showAll ? matching : matching.slice((currentPage - 1) * pageSize, currentPage * pageSize);
      visibleCards.forEach((card) => card.hidden = false);
      if (count) count.textContent = String(matching.length);
      if (empty) empty.hidden = matching.length !== 0;
      if (pagination) pagination.hidden = root.dataset.view === 'explore' || matching.length === 0 || totalPages === 1;
      if (networkCount) networkCount.textContent = String(matching.length);
      if (currentPageLabel) currentPageLabel.textContent = String(currentPage);
      if (totalPageLabel) totalPageLabel.textContent = String(totalPages);
      if (previous) previous.disabled = currentPage <= 1;
      if (next) next.disabled = currentPage >= totalPages;
      renderActiveFilters();
      if (root.dataset.view === 'explore') explorerMode === 'carousel' ? renderCarousel(matching) : renderNetwork(matching);
      if (resetPage) {
        requestAnimationFrame(() => {
          const resultsBounds = list?.getBoundingClientRect();
          if (resultsBounds && (resultsBounds.bottom < 120 || resultsBounds.top > window.innerHeight - 120)) {
            root.querySelector('.resources-topbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }
    };
    const setAccess = (value: string) => {
      if (!access) return;
      access.value = value;
      const selected = accessOptionButtons.find((button) => button.dataset.value === value);
      if (accessLabel) accessLabel.textContent = selected?.querySelector('span:nth-child(2)')?.textContent || '';
      accessOptionButtons.forEach((button) => button.setAttribute('aria-pressed', String(button === selected)));
    };
    const closeAccessMenu = () => { if (accessOptions) accessOptions.hidden = true; accessTrigger?.setAttribute('aria-expanded', 'false'); };
    const resetFilters = () => { if (search) search.value = ''; if (creatorSearch) creatorSearch.value = ''; setAccess('all'); [...typeInputs, ...topicInputs, ...creatorInputs].forEach((input) => input.checked = false); root.querySelectorAll<HTMLElement>('[data-creator-option]').forEach((option) => option.hidden = false); applyFilters(true); };
    search?.addEventListener('input', () => applyFilters(true));
    sort?.addEventListener('change', () => applyFilters(true));
    pageSizeSelect?.addEventListener('change', () => {
      pageSize = pageSizeSelect.value === 'all' ? Infinity : Number(pageSizeSelect.value) || 24;
      localStorage.setItem('dh-resource-page-size', pageSizeSelect.value);
      applyFilters(true);
    });
    access?.addEventListener('change', () => applyFilters(true));
    accessTrigger?.addEventListener('click', () => { const open = accessOptions?.hidden ?? true; if (accessOptions) accessOptions.hidden = !open; accessTrigger.setAttribute('aria-expanded', String(open)); });
    accessOptionButtons.forEach((button) => button.addEventListener('click', () => { setAccess(button.dataset.value || 'all'); closeAccessMenu(); applyFilters(true); }));
    document.addEventListener('click', (event) => { if (accessMenu && !accessMenu.contains(event.target as Node)) closeAccessMenu(); });
    [...typeInputs, ...topicInputs, ...creatorInputs].forEach((input) => input.addEventListener('change', () => applyFilters(true)));
    networkLayerInputs.forEach((input) => input.addEventListener('change', () => {
      clearGraphSelection();
      renderNetwork(currentMatching);
    }));
    creatorSearch?.addEventListener('input', () => {
      const query = creatorSearch.value.trim().toLocaleLowerCase(document.documentElement.lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      root.querySelectorAll<HTMLElement>('[data-creator-option]').forEach((option) => { option.hidden = Boolean(query) && !option.textContent?.toLocaleLowerCase(document.documentElement.lang).normalize('NFD').replace(/[\u0300-\u036f]/g, '').includes(query); });
    });
    root.querySelector('[data-resource-clear]')?.addEventListener('click', resetFilters);
    root.querySelector('[data-resource-reset]')?.addEventListener('click', resetFilters);
    previous?.addEventListener('click', () => { currentPage--; applyFilters(); root.querySelector('.resources-topbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    next?.addEventListener('click', () => { currentPage++; applyFilters(); root.querySelector('.resources-topbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    filterToggle?.addEventListener('click', () => { const open = root.classList.toggle('filters-open'); filterToggle.setAttribute('aria-expanded', String(open)); });
    root.querySelector('[data-filter-close]')?.addEventListener('click', closeFilters);
    root.querySelector('[data-filter-scrim]')?.addEventListener('click', closeFilters);

    type GraphNode = { id: string; label: string; kind: 'resource' | 'type' | 'topic' | 'institution'; x: number; y: number; anchorX: number; anchorY: number; vx: number; vy: number; phase: number; depth: number; motion: number; pinned: boolean; card?: HTMLElement; radius: number; };
    type GraphLink = { source: GraphNode; target: GraphNode; rest: number; weight: number; projected?: boolean; };
    let graphNodes: GraphNode[] = [];
    let graphLinks: GraphLink[] = [];
    let graphTransform = { x: 0, y: 0, scale: 1 };
    let networkResizeFrame = 0;
    let graphAnimationFrame = 0;
    let graphMotionPaused = false;
    let graphDraggedNode: GraphNode | undefined;
    let graphWidth = 0;
    let graphHeight = 0;
    let graphFlowAngle = 0;
    let graphRotationFactor = 1;
    let graphTargetRotation = 1;
    let graphVerticalDrift = 0;
    let graphTargetVerticalDrift = 0;
    let graphVerticalOffset = 0;
    let graphPreviousDragAngle = 0;
    let graphPreviousDragY = 0;
    const graphPins = new Map<string, { x: number; y: number }>();
    const svgNs = 'http://www.w3.org/2000/svg';
    const nodeHash = (value: string) => [...value].reduce((total, character) => ((total << 5) - total + character.charCodeAt(0)) | 0, 0);
    const graphPoint = (event: PointerEvent | WheelEvent) => {
      const bounds = networkSvg?.getBoundingClientRect();
      if (!bounds) return { x: 0, y: 0 };
      return { x: (event.clientX - bounds.left - graphTransform.x) / graphTransform.scale, y: (event.clientY - bounds.top - graphTransform.y) / graphTransform.scale };
    };
    const graphLabels = new Map<string, string>();
    [...typeInputs, ...topicInputs, ...creatorInputs].forEach((input) => graphLabels.set(input.value, labelFor(input)));
    const visibleNetworkLayers = () => new Set(networkLayerInputs.filter((input) => input.checked).map((input) => input.value));

    const persistPins = () => localStorage.setItem(pinStorageKey, JSON.stringify([...pinnedSlugs]));
    const updatePreviewPin = () => {
      const slug = selectedPreviewCard?.dataset.slug || '';
      const isPinned = Boolean(slug && pinnedSlugs.has(slug));
      if (networkPreviewPin) {
        networkPreviewPin.hidden = !slug;
        networkPreviewPin.setAttribute('aria-pressed', String(isPinned));
        const label = isPinned ? (networkPreviewPin.dataset.unpinLabel || '') : (networkPreviewPin.dataset.pinLabel || '');
        networkPreviewPin.setAttribute('aria-label', label);
        networkPreviewPin.title = label;
      }
      if (networkPreviewPinLabel && networkPreviewPin) networkPreviewPinLabel.textContent = isPinned ? (networkPreviewPin.dataset.unpinLabel || '') : (networkPreviewPin.dataset.pinLabel || '');
    };
    const renderPinnedResources = () => {
      if (resourcePinsClear) resourcePinsClear.hidden = pinnedSlugs.size === 0;
      const selectedCards = [...pinnedSlugs].map((slug) => cards.find((card) => card.dataset.slug === slug)).filter((card): card is HTMLElement => Boolean(card));
      const fillPinPanel = (panel: HTMLElement | null, list: HTMLElement | null, count: HTMLElement | null) => {
        if (!panel || !list || !count) return;
        list.replaceChildren();
        panel.hidden = selectedCards.length === 0;
        count.textContent = String(selectedCards.length);
        selectedCards.forEach((card) => {
          const button = document.createElement('button');
          button.type = 'button'; button.className = 'resource-network-pin-card';
          button.setAttribute('aria-label', networkPreviewPin?.dataset.unpinLabel || '');
          button.title = networkPreviewPin?.dataset.unpinLabel || '';
          const pin = document.createElementNS(svgNs, 'svg');
          pin.setAttribute('viewBox', '0 0 24 24');
          pin.setAttribute('aria-hidden', 'true');
          pin.classList.add('resource-network-pin-card-icon');
          pin.innerHTML = '<path d="M12 17v5"/><path d="M5 17h14"/><path d="M6 3h12l-2 7 3 3v1H5v-1l3-3-2-7z"/>';
          const content = document.createElement('span'); content.className = 'resource-network-pin-card-content';
          const kind = document.createElement('small'); kind.textContent = networkPreviewKind?.textContent || '';
          const label = document.createElement('strong'); label.textContent = card.dataset.title || card.dataset.slug || '';
          content.append(kind, label);
          button.append(pin, content);
          button.addEventListener('click', () => { pinnedSlugs.delete(card.dataset.slug || ''); persistPins(); renderPinnedResources(); applyFilters(); });
          list.append(button);
        });
      };
      fillPinPanel(networkPins, networkPinList, networkPinCount);
      fillPinPanel(carouselPins, carouselPinList, carouselPinCount);
      cards.forEach((card) => {
        const isPinned = pinnedSlugs.has(card.dataset.slug || '');
        card.classList.toggle('is-pinned-resource', isPinned);
        const button = card.querySelector<HTMLButtonElement>('[data-resource-pin]');
        if (!button) return;
        const label = isPinned ? (button.dataset.unpinLabel || '') : (button.dataset.pinLabel || '');
        button.setAttribute('aria-pressed', String(isPinned));
        button.setAttribute('aria-label', `${label}: ${card.dataset.title || ''}`);
        button.title = label;
      });
      networkSvg?.querySelectorAll<SVGGElement>('.resource-network-node').forEach((element) => {
        const node = graphNodes.find((candidate) => candidate.id === element.dataset.nodeId);
        element.classList.toggle('is-pinned-resource', Boolean(node?.card && pinnedSlugs.has(node.card.dataset.slug || '')));
      });
      updatePreviewPin();
      updateCarouselPreviewPin();
      drawCarousel();
    };
    const togglePinnedResource = (card: HTMLElement) => {
      const slug = card.dataset.slug || '';
      if (!slug) return;
      const wasPinned = pinnedSlugs.has(slug);
      if (wasPinned) pinnedSlugs.delete(slug); else pinnedSlugs.add(slug);
      card.classList.add('is-pin-changing');
      card.classList.toggle('is-pin-leaving', !wasPinned);
      persistPins();
      renderPinnedResources();
      window.setTimeout(() => {
        const scrollY = window.scrollY;
        applyFilters();
        window.scrollTo({ top: scrollY, behavior: 'instant' });
        card.classList.remove('is-pin-changing', 'is-pin-leaving');
      }, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 360);
    };

    type CarouselParticle = { card: HTMLElement; x: number; y: number; previousX: number; previousY: number; angle: number; radius: number; vertical: number; speed: number; phase: number; depth: number; };
    let carouselParticles: CarouselParticle[] = [];
    let carouselWidth = 0;
    let carouselHeight = 0;
    let carouselFrame = 0;
    let carouselAnimationFrame = 0;
    let carouselRotation = 1;
    let carouselTargetRotation = 1;
    let carouselVerticalDrift = 0;
    let carouselTargetVerticalDrift = 0;
    let carouselVerticalOffset = 0;
    let carouselDragStart = { x: 0, y: 0 };
    let carouselPreviousAngle = 0;
    let carouselPreviousY = 0;
    let carouselDragged = false;
    let carouselPointerActive = false;
    let carouselHovered: CarouselParticle | undefined;
    const carouselReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function carouselPosition(particle: CarouselParticle, initial = false) {
      if (!initial) { particle.previousX = particle.x; particle.previousY = particle.y; }
      const centreX = carouselWidth * .5;
      const centreY = carouselHeight * .5;
      const horizontalRadius = carouselWidth * (.08 + particle.radius * .38);
      const verticalRadius = carouselHeight * (.045 + particle.radius * .3);
      const breathing = Math.sin(carouselFrame * .0012 + particle.phase) * carouselWidth * .016 * particle.depth;
      particle.x = centreX + Math.cos(particle.angle) * (horizontalRadius + breathing);
      const baseY = centreY + Math.sin(particle.angle) * verticalRadius + particle.vertical * carouselHeight * (.07 + particle.radius * .16) + Math.cos(carouselFrame * .001 + particle.phase) * 6 + carouselVerticalOffset * (.3 + particle.depth * .7);
      const span = carouselHeight + 100;
      particle.y = ((baseY + 50) % span + span) % span - 50;
      if (initial) { particle.previousX = particle.x; particle.previousY = particle.y; }
    }

    function drawCarousel() {
      if (!carouselContext || !carouselCanvas || !carouselWidth || !carouselHeight) return;
      carouselContext.clearRect(0, 0, carouselWidth, carouselHeight);
      const dark = document.documentElement.dataset.theme === 'dark';
      const pixel = dark ? '183,132,255' : '98,64,232';
      const line = dark ? '166,112,245' : '112,83,220';
      const accents = dark
        ? ['#ff79c6', '#8fb8ff', '#d49cff', '#a78bfa', '#75d7f0', '#ef8cff']
        : ['#c13e9a', '#4169d8', '#8b4bd8', '#6547c7', '#168fb5', '#ad4fc9'];
      const centreX = carouselWidth * .5, centreY = carouselHeight * .5;
      carouselContext.lineWidth = .65;
      for (let ring = 1; ring <= 5; ring += 1) {
        carouselContext.strokeStyle = `rgba(${line},${.025 + ring * .007})`;
        carouselContext.beginPath();
