---
import { ArrowLeft, ArrowUpRight, CalendarRange, Grid2X2, List, Search } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { lang: 'lv' | 'en'; }
const { lang } = Astro.props;
const isLv = lang === 'lv';
const alternateUrl = isLv ? '/en/projects/' : '/lv/projekti/';

const projects = [
  {
    id: 'teiktas-dziesmas', acronym: isLv ? 'Teiktās dziesmas' : 'Spoken Songs', visualAcronym: isLv ? 'TD' : 'SS', years: '2026–2028', status: 'active',
    title: isLv ? 'Teiktās dziesmas: kompozīcijas un improvizācijas algoritmi' : 'Spoken Songs: Algorithms of Composition and Improvisation',
    description: isLv ? 'Starpdisciplinārs pētījums par teikto dziesmu kompozīcijas un improvizācijas principiem, izmantojot digitālas pētniecības metodes.' : 'An interdisciplinary study of composition and improvisation in spoken songs using digital research methods.',
    tags: isLv ? ['Kultūras mantojums', 'Datu analīze'] : ['Cultural heritage', 'Data analysis'], image: '/assets/projects/teiktas-dziesmas.png', imageStyle: 'logo',
    url: 'https://lulfmi.lv/en/research/projects/spoken-songs-algorithms-of-composition-and-improvisation',
  },
  {
    id: 'digilate', acronym: 'DigiLATE', years: '2025–2028', status: 'active',
    title: isLv ? 'Digitālie resursi un mākslīgā intelekta tehnoloģijas latviešu valodas ilgtspējai' : 'Digital Resources and Artificial Intelligence Technologies for the Sustainability of the Latvian Language',
    description: isLv ? 'Latviešu valodas digitālo resursu un mākslīgā intelekta tehnoloģiju attīstība pētniecībai, izglītībai un sabiedrībai.' : 'Development of Latvian-language digital resources and AI technologies for research, education and society.',
    tags: isLv ? ['Valodu tehnoloģijas', 'Mākslīgais intelekts'] : ['Language technology', 'Artificial intelligence'], image: '/assets/projects/digilate.png', imageStyle: 'logo',
  },
  {
    id: 'vti', acronym: 'VTI', years: '2022–2026', status: 'completed',
    title: isLv ? 'Valodu tehnoloģiju iniciatīva' : 'Language Technology Initiative',
    description: isLv ? 'Augsta līmeņa digitālo prasmju, valodu tehnoloģiju un starpinstitucionālas sadarbības attīstības iniciatīva.' : 'An initiative supporting advanced digital skills, language technologies and inter-institutional cooperation.',
    tags: isLv ? ['Valodu tehnoloģijas', 'Izglītība'] : ['Language technology', 'Education'], image: '/assets/projects/vti.jpg', imageStyle: 'cover',
  },
  {
    id: 'dheli', acronym: 'DHELI', years: '2023–2025', status: 'completed',
    title: isLv ? 'Atvērtas un FAIR principiem atbilstīgas digitālo humanitāro zinātņu ekosistēmas attīstība Latvijā' : 'Towards Development of an Open and FAIR Digital Humanities Ecosystem in Latvia',
    description: isLv ? 'Projekts attīstīja atvērtu, savietojamu un FAIR principiem atbilstošu digitālo humanitāro zinātņu ekosistēmu Latvijā.' : 'The project developed an open, interoperable and FAIR-aligned digital humanities ecosystem in Latvia.',
    tags: isLv ? ['FAIR dati', 'Infrastruktūra'] : ['FAIR data', 'Infrastructure'], image: '/assets/projects/dheli.jpg', imageStyle: 'cover',
  },
  {
    id: 'late', acronym: 'LATE', years: '2022–2024', status: 'completed',
    title: isLv ? 'Mūsdienu latviešu valodas izpēte un valodas tehnoloģiju attīstība' : 'Research on Modern Latvian Language and Development of Language Technology',
    description: isLv ? 'Mūsdienu latviešu valodas izpēte un digitālu valodas resursu un tehnoloģiju attīstība.' : 'Research on modern Latvian and the development of digital language resources and technologies.',
    tags: isLv ? ['Valodniecība', 'Valodu tehnoloģijas'] : ['Linguistics', 'Language technology'], image: '/assets/projects/late.jpg', imageStyle: 'cover',
  },
  {
    id: 'dh-vpp', acronym: 'DH VPP', years: '2020–2022', status: 'completed',
    title: isLv ? 'Humanitāro zinātņu digitālie resursi: integrācija un attīstība' : 'Digital Resources for the Humanities: Integration and Development',
    description: isLv ? 'Valsts pētījumu programma digitālo resursu integrācijai, pētniecības infrastruktūras stiprināšanai un jaunu rīku attīstībai.' : 'A national research programme integrating digital resources, strengthening research infrastructure and developing new tools.',
    tags: isLv ? ['Digitālie resursi', 'Infrastruktūra'] : ['Digital resources', 'Infrastructure'], image: '/assets/projects/dh-vpp.jpg', imageStyle: 'logo',
  },
  {
    id: 'lu-open', acronym: 'ȬPEN', years: '2026–2028', status: 'active',
    title: isLv ? 'Atvērtās zināšanu ekosistēmas sabiedriskās zinātnes attīstībai' : 'Open Knowledge Ecosystems for the Development of Citizen Science',
    description: isLv ? 'Atvērto zināšanu, sabiedriskās zinātnes un pētniecības kopienu sadarbības ekosistēmas attīstība.' : 'Development of an ecosystem for open knowledge, citizen science and cooperation among research communities.',
    tags: isLv ? ['Sabiedriskā zinātne', 'Atvērtā zinātne'] : ['Citizen science', 'Open science'], imageStyle: 'placeholder',
  },
  {
    id: 'going-beyond-search', acronym: 'NORDPLUS', years: '2019–2021', status: 'completed',
    title: isLv ? 'Going Beyond Search: digitālo kompetenču attīstība bibliotēkās un pētniecības kopienās' : 'Going Beyond Search: Advancing Digital Competences in Libraries and Research Communities',
    description: isLv ? 'Ziemeļvalstu un Baltijas sadarbības projekts digitālo kompetenču pilnveidei bibliotēkās un pētniecības kopienās.' : 'A Nordic–Baltic cooperation project advancing digital competences in libraries and research communities.',
    tags: isLv ? ['Digitālās prasmes', 'Bibliotēkas'] : ['Digital skills', 'Libraries'], image: '/assets/projects/going-beyond-search.jpg', imageStyle: 'logo',
  },
];
const projectPriority = new Map([['digilate', 0], ['lu-open', 1], ['teiktas-dziesmas', 2]]);
projects.sort((a, b) => (projectPriority.get(a.id) ?? 100) - (projectPriority.get(b.id) ?? 100));

const copy = isLv ? {
  title: 'Projekti', description: 'Sadarbības projekti digitālo humanitāro zinātņu jomā.',
  intro: 'Sadarbības projekti digitālo humanitāro zinātņu jomā.',
  search: 'Meklēt projektos', searchPlaceholder: 'Nosaukums, tēma vai atslēgvārds…', status: 'Projekta statuss', all: 'Visi projekti', active: 'Aktīvie', completed: 'Pabeigtie', count: 'projekti', noResults: 'Neviens projekts neatbilst izvēlētajiem filtriem.', external: 'Projekta tīmekļvietne', more: 'Pilna informācija', cards: 'Kartītes', list: 'Saraksts', view: 'Mainīt skatu',
} : {
  title: 'Projects', description: 'Collaborative projects in the field of digital humanities.',
  intro: 'Collaborative projects in the field of digital humanities.',
  search: 'Search projects', searchPlaceholder: 'Title, topic or keyword…', status: 'Project status', all: 'All projects', active: 'Active', completed: 'Completed', count: 'projects', noResults: 'No projects match the selected filters.', external: 'Project website', more: 'Full project information', cards: 'Cards', list: 'List', view: 'Change view',
};
---
<BaseLayout title={`${copy.title} — Digital Humanities LV`} description={copy.description} lang={lang} alternateUrl={alternateUrl}>
  <div class="projects-page" data-alternate-base={alternateUrl}>
    <section class="page-heading projects-heading shell"><a class="back-link projects-home-link" href={isLv ? '/lv/' : '/en/'}><ArrowLeft size={17} />{isLv ? 'Uz sākumlapu' : 'Back to home'}</a><h1>{copy.title}</h1><p class="lead">{copy.intro}</p></section>
    <section class="projects-directory shell" data-project-directory data-view="cards">
      <div class="projects-toolbar">
        <label class="project-search"><span class="sr-only">{copy.search}</span><Search size={18} /><input type="search" placeholder={copy.searchPlaceholder} data-project-search /></label>
        <label class="project-status"><span>{copy.status}</span><select data-project-status><option value="all">{copy.all}</option><option value="active">{copy.active}</option><option value="completed">{copy.completed}</option></select></label>
        <div class="project-view-toggle" aria-label={copy.view}>
          <button type="button" data-project-view="cards" aria-pressed="true" title={copy.cards}><Grid2X2 size={17} /><span>{copy.cards}</span></button>
          <button type="button" data-project-view="list" aria-pressed="false" title={copy.list}><List size={18} /><span>{copy.list}</span></button>
        </div>
        <p><strong data-project-count>{projects.length}</strong> {copy.count}</p>
      </div>
      <div class="project-list">
        {projects.map((project) => {
          const hasDetail = isLv || project.id !== 'lu-open';
          const detailUrl = isLv ? `/lv/projekti/${project.id}/` : `/en/projects/${project.id}/`;
          return (
          <article id={project.id} class="project-row" data-project data-status={project.status} data-search={`${project.acronym} ${project.title} ${project.description} ${project.tags.join(' ')}`.toLocaleLowerCase(lang)}>
            <a class:list={['project-image', project.imageStyle, project.image && 'has-image']} href={hasDetail ? detailUrl : `#${project.id}`} aria-label={project.title}>{project.image && <img src={project.image} alt="" loading="lazy" />}<span class="project-acronym" aria-hidden="true">{'visualAcronym' in project ? project.visualAcronym : project.acronym}</span></a>
            <div class="project-card-content">
              <div class="project-card-top"><strong>{project.acronym}</strong><span class="project-years"><CalendarRange size={15} />{project.years}</span><span class:list={['project-state', project.status]}>{project.status === 'active' ? copy.active : copy.completed}</span></div>
              <div class="project-main"><h2>{hasDetail ? <a href={detailUrl}>{project.title}</a> : project.title}</h2><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><div class="project-links">{hasDetail && <a class="text-link" href={detailUrl}>{copy.more}<ArrowUpRight size={16} /></a>}{project.url && <a class="text-link" href={project.url} target="_blank" rel="noreferrer">{copy.external}<ArrowUpRight size={16} /></a>}</div></div>
            </div>
          </article>
        )})}
      </div>
      <p class="projects-empty" data-project-empty hidden>{copy.noResults}</p>
    </section>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector<HTMLElement>('.projects-page');
  const search = document.querySelector<HTMLInputElement>('[data-project-search]');
  const status = document.querySelector<HTMLSelectElement>('[data-project-status]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-project]')];
  const count = document.querySelector<HTMLElement>('[data-project-count]');
  const empty = document.querySelector<HTMLElement>('[data-project-empty]');
  const directory = document.querySelector<HTMLElement>('[data-project-directory]');
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-project-view]')];
  const languageLink = document.querySelector<HTMLAnchorElement>('.language');
  const ids = new Set(rows.map((row) => `#${row.id}`));
  const filter = () => {
    const query = search?.value.trim().toLocaleLowerCase(document.documentElement.lang) || '';
    const selected = status?.value || 'all';
    let visible = 0;
    rows.forEach((row) => {
      const show = (!query || row.dataset.search?.includes(query)) && (selected === 'all' || row.dataset.status === selected);
      row.hidden = !show;
      if (show) visible++;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
  };
  search?.addEventListener('input', filter);
  status?.addEventListener('change', filter);
  const setView = (view: 'cards' | 'list') => {
    if (!directory) return;
    directory.dataset.view = view;
    viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.projectView === view)));
    localStorage.setItem('dh-project-view', view);
  };
  const savedView = localStorage.getItem('dh-project-view');
  setView(savedView === 'list' ? 'list' : 'cards');
  viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.projectView === 'list' ? 'list' : 'cards')));
  const updateLanguageLink = () => {
    if (!page || !languageLink) return;
    languageLink.href = `${page.dataset.alternateBase}${ids.has(location.hash) ? location.hash : ''}`;
  };
  updateLanguageLink();
  addEventListener('hashchange', updateLanguageLink);
</script>
