---
import BssdhYearPage from '../../../../components/BssdhYearPage.astro';
import { bssdhYears } from '../../../../data/bssdh';
export function getStaticPaths(){ return bssdhYears.filter(({externalUrl}) => !externalUrl).map(({year}) => ({params:{year}})); }
const { year } = Astro.params;
---
<BssdhYearPage lang="lv" year={year!} />
