---
import AboutPage from '../../../components/AboutPage.astro';
export function getStaticPaths() {
 const pages = [
  ['lv','par-mums','Par mums','Kontakti, sociālie tīkli un iesaistītās institūcijas.','/en/about-us/'],
  ['en','about-us','About us','Contacts, social media and participating institutions.','/lv/par-mums/'],
] as const;
 return pages.map(([lang,slug,title,description,alternateUrl]) => ({params:{lang,slug},props:{lang,title,description,alternateUrl}}));
}
const { lang, title, description, alternateUrl } = Astro.props;
---
<AboutPage lang={lang} alternateUrl={alternateUrl} />
